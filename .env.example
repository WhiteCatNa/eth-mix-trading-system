# BETA-TREND Desk — Binance credentials (never commit a filled .env)
# Research / demo / local paper need no keys.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# 1 = USD-M futures testnet. Keep this on until you explicitly go live.
BINANCE_TESTNET=1

# Live is refused unless ALL of: mode=live, BETATREND_ALLOW_LIVE=1, CLI confirmation YES
BETATREND_ALLOW_LIVE=0

# Flatten immediately (also created by touching data/KILL)
BETATREND_KILL=0
