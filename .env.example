# BETA-TREND Desk — Binance credentials (never commit a filled .env)
# Research / demo / local paper need no keys.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# 1 = USD-M futures testnet. Keep this on until you explicitly go live.
# 0 + a non-testnet signed client = mainnet. CLI paper/backtest still do not place orders.
BINANCE_TESTNET=1

# Required for ANY mainnet order (client.testnet=False), including account.mode=testnet.
# Also need confirm=YES on submit_intents / new_order. Default oms.testnet_only=true still refuses mainnet.
BETATREND_ALLOW_LIVE=0
